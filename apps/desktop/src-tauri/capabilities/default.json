{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Island and Eternal Helper's own windows",
  "windows": [
    "island",
    "settings",
    "panel-*",
    "cloudy",
    "pet",
    "shot"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-focus",
    "core:window:allow-show",
    "core:window:allow-hide",
    "opener:default",
    "clipboard-manager:allow-write-text",
    "clipboard-manager:allow-read-text",
    "autostart:default",
    "dialog:allow-open",
    "clipboard-manager:allow-write-image",
    "allow-get-settings",
    "allow-set-settings",
    "allow-island-layout",
    "allow-island-set-hit",
    "allow-island-set-expanded",
    "allow-media-now",
    "allow-media-control",
    "allow-planner-info",
    "allow-planner-snapshot",
    "allow-planner-open",
    "allow-secret-set",
    "allow-secret-has",
    "allow-afina-ask",
    "allow-rec-info",
    "allow-rec-begin",
    "allow-rec-append",
    "allow-rec-finish",
    "allow-rec-cancel",
    "allow-rec-native-start",
    "allow-rec-native-stop",
    "allow-rec-list",
    "allow-rec-rename",
    "allow-rec-delete",
    "allow-rec-open",
    "allow-rec-open-folder",
    "allow-open-window",
    "allow-battery",
    "allow-update-check",
    "allow-update-install",
    "allow-music-services",
    "allow-music-open",
    "allow-music-hide",
    "allow-music-control",
    "allow-music-sign-out",
    "allow-shot-start",
    "allow-shot-image",
    "allow-shot-save",
    "allow-shot-close",
    "allow-shot-reveal",
    "allow-controls-read",
    "allow-controls-set",
    "allow-wifi-networks",
    "allow-wifi-connect",
    "allow-open-system-settings",
    "allow-afina-find-files",
    "allow-afina-find-text",
    "allow-afina-open",
    "allow-ai-services",
    "allow-ai-open",
    "allow-open-url",
    "allow-window-ready",
    "allow-quit"
  ]
}
